# Copie para .env e preencha:  cp .env.example .env

# Domínio onde o app vai ficar (o mesmo usado no Nginx)
DOMAIN=cine.campostecnologia.cloud

# IP público da VPS (Hostinger)  ->  curl -4 ifconfig.me
PUBLIC_IP=0.0.0.0

# Segredo compartilhado entre o app e o coturn. Gere com:  openssl rand -hex 32
TURN_SECRET=troque-por-um-segredo-longo

# (Opcional) exige um código para CRIAR salas — evita que estranhos usem seu servidor.
# Quem só ENTRA pelo link não precisa dele.
ACCESS_CODE=

# Porta local onde o app escuta (o Nginx faz proxy para ela)
APP_PORT=3100
